# Copy this file to .env or configure these variables in your runtime environment.

DOC_AI_MANAGER_HOST=
DOC_AI_NODE1_HOST=
DOC_AI_NODE2_HOST=
DOC_AI_NODE3_HOST=

MYSQL_HOST=infra_mysql
MYSQL_PORT=3306
MYSQL_DATABASE=doc_ai
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_LOCAL_HOST=localhost
MYSQL_LOCAL_PORT=3306
MYSQL_LOCAL_USERNAME=root
MYSQL_LOCAL_PASSWORD=

REDIS_HOST=infra_redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_LOCAL_HOST=localhost
REDIS_LOCAL_PASSWORD=

RABBITMQ_HOST=infra_rabbitmq
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

MINIO_ENDPOINT=http://infra_minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_LOCAL_ENDPOINT=http://localhost:9000

NACOS_MYSQL_PASSWORD=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1536
OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
DOC_AI_ADMIN_PASSWORD=
DOC_AI_USER_PASSWORD=
TEST_USER_PASSWORD=
SERVER_ADDRESS=
OBSIDIAN_HOST=
NACOS_USERNAME=
NACOS_PASSWORD=
DOC_AI_PASSWORD_HASH=
DOC_AI_ADMIN_EMAIL=
DOC_AI_USER_EMAIL=
TEST_USER_EMAIL=
DOC_AI_ADMIN_PHONE=
DOC_AI_USER_PHONE=
OPENAI_API_KEY=
NACOS_PASSWORD_HASH=
VITE_API_TARGET=http://localhost:8080

# Authentication security. Generate independent random values before deployment.
# Rotation: prepend a new kid:secret entry, set JWT_ACTIVE_KID to it, keep the old entry until old tokens expire.
JWT_KEYS=current:replace-with-a-random-secret-of-at-least-32-bytes
JWT_ACTIVE_KID=current
INTERNAL_SERVICE_TOKEN=replace-with-an-independent-random-service-token
# Empty by default. Set all four values only on a brand-new installation,
# start user-service once, then remove them from the environment.
SMARTDOC_BOOTSTRAP_ADMIN_USERNAME=
SMARTDOC_BOOTSTRAP_ADMIN_PASSWORD=
SMARTDOC_BOOTSTRAP_ADMIN_EMAIL=
SMARTDOC_BOOTSTRAP_ADMIN_PHONE=
SECURITY_MALWARE_SCAN_ENABLED=true
SECURITY_MALWARE_SCAN_REQUIRED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
PASSWORD_RESET_DELIVERY_URL=https://private-mail-relay.example.com/send
PASSWORD_RESET_DELIVERY_TOKEN=replace-with-mail-relay-token
PASSWORD_RESET_FRONTEND_URL=https://docs.example.com/reset-password
JWT_KEYS_SECRET_FILE=./secrets/jwt_keys.txt
INTERNAL_SERVICE_TOKEN_SECRET_FILE=./secrets/internal_service_token.txt

# Meeting recording transcription: DashScope Qwen3 ASR. DeepSeek only generates the minutes.
# The direct Base64 mode is for recordings within about 7MB / 5 minutes.
DASHSCOPE_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
SMARTDOC_AI_CREDENTIAL_MASTER_KEY=replace-with-a-random-secret-at-least-16-characters
