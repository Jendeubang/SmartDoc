# Copy this file to reproduce/.env.local and fill the values below.

DOC_AI_MANAGER_HOST=localhost
DOC_AI_NODE1_HOST=localhost
DOC_AI_NODE2_HOST=localhost
DOC_AI_NODE3_HOST=localhost

MYSQL_DATABASE=doc_ai
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456

REDIS_HOST=redis
REDIS_PASSWORD=123456

RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

NACOS_MYSQL_PASSWORD=123456
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Fill at least one real model key if you need AI endpoints.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

SERVER_ADDRESS=0.0.0.0
VITE_API_TARGET=http://localhost:8080
VITE_AI_TARGET=http://localhost:8083
